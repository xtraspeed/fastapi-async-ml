# Application
PROJECT_NAME="Async ML Risk Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Broker & Backend Settings
RABBITMQ_URL="amqp://guest:guest@localhost:5672//"
REDIS_URL="redis://localhost:6379/0"

# Caching & Worker
CACHE_TTL_SECONDS=3600
CELERY_TASK_TIMEOUT=300
MODEL_ARTIFACT_PATH="app/models/model_artifacts.joblib"

# Fail-fast tuning: keep outage responses (503) fast instead of blocking on
# Celery's default broker/backend retry loops.
BROKER_CONNECTION_TIMEOUT=3.0
REDIS_SOCKET_TIMEOUT=3.0
